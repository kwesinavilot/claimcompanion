{
    "name": "@claim-companion/mcp-server",
    "version": "0.6.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx --env-file=.env src/server.ts",
        "build": "tsc && tsc --project apps/tsconfig.json && tsx apps/build.ts",
        "start": "node --env-file=.env dist/server.js",
        "test": "tsx --test src/*.test.ts",
        "smoke": "tsx --env-file=.env src/smoke.ts",
        "smoke:core": "tsx --env-file=.env src/core-smoke.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/ext-apps": "^1.7.5",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "qrcode": "^1.5.4",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^2.9.0",
        "@types/node": "^24.0.0",
        "@types/qrcode": "^1.5.6",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0",
        "vite": "^7.3.7"
    }
}
